{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh api repos/dmitrytut/esport-tycoon/issues:*)",
      "Bash(gh api repos/dmitrytut/esport-tycoon/labels:*)",
      "Bash(gh api repos/dmitrytut/esport-tycoon/milestones:*)",
      "Bash(gh api repos/dmitrytut/esport-tycoon/pulls/*/comments:*)",
      "Bash(pnpm:*)",
      "Bash(openspec:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh api repos/dmitrytut/esport-tycoon/pulls/*/merge:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-path.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-golden.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
