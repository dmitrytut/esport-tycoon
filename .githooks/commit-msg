#!/bin/sh
# A commit that changes golden or baseline must explain the shift (tests/README.md).
set -e

message_file="$1"
subject=$(head -n 1 "$message_file")
body_lines=$(sed '1d' "$message_file" | grep -cv '^[[:space:]]*\(#.*\)\?$' || true)

touches_golden=$(git diff --cached --name-only --diff-filter=ACMD \
  | grep -E '^(packages/.*/test/golden/|tests/golden/|sim/baseline/)' || true)

if [ -n "$touches_golden" ]; then
  case "$subject" in
    golden:*|baseline:*) ;;
    *)
      echo "Rejected: commit changes golden/baseline, but the subject does not start with golden: or baseline:" >&2
      exit 1
      ;;
  esac
  if [ "$body_lines" -eq 0 ]; then
    echo "Rejected: golden/baseline update with no explanation. Describe in the commit body exactly what in the rules shifted the numbers." >&2
    exit 1
  fi
fi
