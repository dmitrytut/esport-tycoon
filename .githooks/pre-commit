#!/bin/sh
# Local gate. Enabled once: pnpm run hooks:install
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

# Rule from tests/README.md: golden and baseline are updated deliberately, in a separate commit.
# A mixed "code + golden" commit is the most common way to hide a balance regression.
golden=$(printf '%s\n' "$staged" | grep -E '^(packages/.*/test/golden/|tests/golden/|sim/baseline/)' || true)
code=$(printf '%s\n' "$staged" | grep -E '^(packages|apps|tools)/.*\.(ts|tsx)$' | grep -v '/test/golden/' || true)

if [ -n "$golden" ] && [ -n "$code" ]; then
  echo "Rejected: both code and golden files in the same commit." >&2
  echo "Commit the code first, then golden separately, prefixed golden: with an explanation of what shifted the numbers." >&2
  echo "Golden in the index:" >&2
  printf '  %s\n' "$golden" >&2
  exit 1
fi

pnpm run verify
