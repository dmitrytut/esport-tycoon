#!/bin/sh
# Локальный гейт. Включается один раз: pnpm run hooks:install
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

# Правило tests/README.md: golden и baseline обновляются осознанно, отдельным коммитом.
# Смешанный коммит «код + golden» — самый частый способ спрятать регрессию баланса.
golden=$(printf '%s\n' "$staged" | grep -E '^(packages/.*/test/golden/|tests/golden/|sim/baseline/)' || true)
code=$(printf '%s\n' "$staged" | grep -E '^(packages|apps|tools)/.*\.(ts|tsx)$' | grep -v '/test/golden/' || true)

if [ -n "$golden" ] && [ -n "$code" ]; then
  echo "Отказ: в одном коммите и код, и golden-файлы." >&2
  echo "Сначала закоммить код, потом golden отдельно, префиксом golden: и объяснением механизма сдвига." >&2
  echo "Golden в индексе:" >&2
  printf '  %s\n' "$golden" >&2
  exit 1
fi

pnpm run verify
