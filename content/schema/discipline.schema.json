{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discipline",
  "type": "object",
  "required": ["id", "name", "rosterSize", "statWeights", "contest", "economy"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "English discipline name, shown to the player (docs/adr/0007)"
    },
    "rosterSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "statWeights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical",
        "cognitive",
        "collective",
        "composure",
        "adaptability",
        "presence"
      ],
      "properties": {
        "mechanical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cognitive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "collective": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "composure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "adaptability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "presence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "metaVolatility": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "how often and how strongly patches shift the weights"
    },
    "contest": {
      "type": "object",
      "required": [
        "kind",
        "scoreToWin",
        "maxUnits",
        "energyCost",
        "momentumMeans",
        "sideChance",
        "momentumRetentionBps",
        "slots",
        "metrics",
        "momentTypes"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["head-to-head"]
        },
        "scoreToWin": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "maxUnits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 198
        },
        "energyCost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "momentumMeans": {
          "type": "string",
          "minLength": 1,
          "description": "what the bar means in this discipline; the text is English, shown to the player (docs/adr/0007)"
        },
        "sideChance": {
          "type": "object",
          "required": ["strengthBpsPerDeciPoint", "momentumBpsPerPoint", "underdogFloorBps"],
          "additionalProperties": false,
          "properties": {
            "strengthBpsPerDeciPoint": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "momentumBpsPerPoint": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "underdogFloorBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4999
            }
          }
        },
        "momentumRetentionBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "scoring"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "scoring": {
                "type": "boolean"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "momentTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "slot", "weight", "momentumShift", "participantMetricDeltas"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "slot": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "momentumShift": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "participantMetricDeltas": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9-]+$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": -100,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },
    "economy": {
      "type": "object",
      "required": ["baseWeeklyRate", "salaryScale"],
      "additionalProperties": false,
      "properties": {
        "baseWeeklyRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prizeScale": {
          "type": "number"
        },
        "viewerScale": {
          "type": "number"
        },
        "salaryScale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "strongRegions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
