{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Регион",
  "type": "object",
  "required": [
    "id",
    "name",
    "language",
    "modifiers"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "английское название региона: его видит пользователь, см. docs/adr/0007"
    },
    "language": {
      "type": "string",
      "description": "язык региона по умолчанию: на нём говорят все, кто здесь сгенерирован. Механика химии состава, не язык интерфейса — см. specs/0006",
      "pattern": "^[a-z]{2}$"
    },
    "secondLanguages": {
      "type": "array",
      "description": "дополнительные языки и вероятность владения при генерации, см. specs/0006",
      "items": {
        "type": "object",
        "required": [
          "language",
          "chance"
        ],
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "timezoneOffset": {
      "type": "integer",
      "minimum": -12,
      "maximum": 14
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "salaryScale": {
          "type": "number"
        },
        "talentDensity": {
          "type": "number"
        },
        "growthScale": {
          "type": "number"
        },
        "burnoutScale": {
          "type": "number"
        },
        "sponsorWealth": {
          "type": "number"
        },
        "prestigeScale": {
          "type": "number"
        },
        "visaRisk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "audienceScale": {
          "type": "number"
        }
      }
    },
    "namePools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
