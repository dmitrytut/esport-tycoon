{
  "name": "esport-tycoon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "validate:content": "node tools/validate-content/src/index.ts",
    "validate:spec": "openspec validate --all",
    "check:lockfile": "node tools/check-lockfile/src/index.ts",
    "check:language": "node tools/check-language/src/index.ts",
    "labels:check": "node tools/sync-labels/src/index.ts",
    "labels:apply": "node tools/sync-labels/src/index.ts --apply",
    "verify": "pnpm run check:lockfile && pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run validate:content && pnpm run validate:spec && pnpm run check:language",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.0",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.0",
    "prettier": "~3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
